{
  "name": "ruki-study-companion",
  "version": "1.0.0",
  "description": "Ruki - Your AI Study Companion",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && vite",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.ruki.studycompanion",
    "productName": "Ruki",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "assets"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
